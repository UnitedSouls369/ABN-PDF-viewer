{
  "name": "ABN PDF Viewer",
  "short_name": "PDF Viewer",
  "description": "PDF's lezen, doorzoeken en van opmerkingen voorzien, lokaal in de browser.",
  "id": "./index.html",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "background_color": "#F5F9FA",
  "theme_color": "#004974",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "file_handlers": [
    { "action": "./index.html", "accept": { "application/pdf": [".pdf"] }, "launch_type": "single-client" }
  ]
}
